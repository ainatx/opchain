{
  "schema": 1,
  "profile": "harbor-cafe",
  "environment": "uat",
  "allowed_origins": [
    "https://uat.example.test"
  ],
  "viewport": {
    "width": 1280,
    "height": 800
  },
  "sign_in": {
    "url": "https://uat.example.test/login",
    "done_selector": "#account-menu"
  },
  "steps": [
    {
      "id": "S-01",
      "do": "navigate",
      "url": "https://uat.example.test/orders"
    },
    {
      "id": "S-02",
      "do": "click",
      "selector": "#new-order"
    },
    {
      "id": "S-03",
      "do": "fill",
      "selector": "#customer",
      "value": "Test Customer 01"
    }
  ]
}
