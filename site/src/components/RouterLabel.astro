---
/**
 * RouterLabel — the skill router's status label, placed beside every piece of
 * router copy (router release term 1). The text comes from
 * src/data/router-status.ts so it changes in one place at the release cut.
 */
import { ROUTER_LABEL } from "../data/router-status";
---

<span class="router-label" data-router-label>{ROUTER_LABEL}</span>

<style>
  .router-label {
    display: inline-block;
    vertical-align: middle;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--warning);
    border: 0.5px solid var(--warning);
    background: var(--warning-dim);
    border-radius: var(--r-xs);
    padding: 1px 8px;
    white-space: normal;
    text-transform: none;
  }
</style>
