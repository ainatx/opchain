---
/**
 * /changelog — Option C v2 layout: three full-width ARIA tabs, each with its
 * own colour identity, every section led by a rich card expanded on load.
 *
 *   Just Released → v1.8 open hero (accent) + v1.7 / v1.6 / v1.5 / v1.4.3
 *                   collapsed heroes (the "active" window) + compact release
 *                   cards (v1.4.2 ↓, older).
 *   Coming Next   → v1.9 assurance and governed delivery — direction set.
 *   Planned       → committed v2.0 self-improvement plan, then votable
 *                   v2.1/v2.2/v2.3 roadmap groups and the request form.
 *
 * Voting is real: vote buttons carry data-vote-target=<id> and the client
 * script batches GET /api/votes then POSTs /api/votes/<id> per click (the
 * Worker dedups per-IP/day in KV). Votable ids are GitHub issue numbers
 * (e.g. "42") pulled live from `asfbay-bit/opchain-skills` via
 * `loadRoadmap()` — see scripts/gen-roadmap.mjs and
 * docs/plans/2026-08-26-roadmap-github-issues.md. The v1.9 and v2.0 scope
 * is committed; voting is attached only to the v2.1-v2.3 candidates. All
 * roadmap items are `roadmap:planned` issues, distinguished by milestone.
 * v1.8 shipped 2026-07-10, so it has no vote buttons.
 *
 * Deep links (#v1-8/#v1-7/#v1-6/#v1-5 → Just Released; #v1-9 → Coming Next;
 * #v2-0/#v2-1/#v2-2/#v2-3 → Planned; #v1-4 → /coverage) are handled client-side:
 * the matching tab is activated, the target card expanded, and scrolled into
 * view.
 *
 * Accessibility: tablist with roving tabindex + arrow/Home/End keys; the
 * inactive panels are `hidden` (not a CSS slide — keeps the page Axe-clean);
 * each card is a button[aria-expanded] controlling an `inert` detail region.
 * The tab bar is deliberately NOT sticky — the global Header already is.
 */
import Base from "../layouts/Base.astro";
import RoadmapForm from "../components/RoadmapForm.astro";
import { loadRoadmap, itemsForMilestone } from "../data/roadmap-types";

const roadmap = loadRoadmap();

// v1.7 "Seams & Signals" — shipped release. Three new skills take the catalog
// 24 → 27, lockstep-bumped to 1.7.0. Per the plan of record, oc-signal-forge
// lands first as 1.7; the oc-modularize-ops → oc-fleet-ops chain follows in
// 1.7.1. Source: docs/releases/1.7-plan.md.
const v17Skills = [
  {
    name: "oc-signal-forge",
    command: "/oc-signal",
    tag: "1.7",
    blurb:
      "Question → trustworthy metric. Designs the instrumentation, builds the harvester + transform, and adversarially proves the signal answers the question before wiring it to oc-dash-forge. The product-analytics backend none of the instrumentation skills owned.",
  },
  {
    name: "oc-modularize-ops",
    command: "/oc-modularize",
    tag: "1.7.1",
    blurb:
      'Decompose a live monolith with provably zero functionality/data loss — golden fixtures captured from real traffic as the equivalence oracle. Willing to say "don\'t." Hands the code-move + cutover to oc-migration-ops and deploy to oc-fleet-ops.',
  },
  {
    name: "oc-fleet-ops",
    command: "/oc-fleet",
    tag: "1.7.1",
    blurb:
      "Provision, deploy, and operate one-or-more containers across self-managed infra (k8s/Nomad/Compose, IaC, on-prem VMs, GCE). Terraform when it fits, not by reflex. Claims the bare-metal/VPS territory oc-deploy-ops routes away — its peer, not its rival.",
  },
];

// v1.8 "Documentation & repo hygiene" — shipped 2026-07-10. Adds oc-docs-forge
// and oc-repo-ops as the pair responsible for PR documentation, README/
// product-doc upkeep, repo cleanliness, and readiness evidence; the every-PR
// gate (docs-forge → repo-ops → bug-check) is wired through oc-git-ops.
const v18Skills = [
  {
    name: "oc-docs-forge",
    command: "/oc-docs",
    blurb:
      "Generates the PR documentation packet, PR-body documentation section, optional PR comment, README deltas, and product-doc updates from the actual change set.",
  },
  {
    name: "oc-repo-ops",
    command: "/oc-repo",
    blurb:
      "Runs the repo-readiness gate: generated files, docs catalogs, link hygiene, ignore-rule consistency, dirty related files, and release-surface cleanup before every PR.",
  },
];

// v2.0 is committed. v2.1-v2.3 are the voting horizon: their issue-level vote
// controls preserve the existing vote ids while making the sequence explicit.
// v2.0 is NOT listed here: at the v1.9 cut it moved to the Coming Next panel as
// the committed next release (hero #v2-0). Keeping a Planned card for it too
// would duplicate that DOM id.
const plannedReleaseGroups = [
  {
    version: "v2.1",
    id: "v2-1",
    title: "Distribution and installation",
    timing: "voting open",
    summary:
      "Make opchain easier to discover and install in the places people already work: the public catalog, Claude.ai, and editors.",
    votable: true,
    items: itemsForMilestone(roadmap, "planned", "v2.1").map((item) => ({
      id: item.id,
      title: item.title,
      blurb: item.blurb,
    })),
  },
  {
    version: "v2.2",
    id: "v2-2",
    title: "Agency and multi-project delivery",
    timing: "voting open",
    summary:
      "Give studios and larger programs first-class coordination across clients, repositories, checkpoints, releases, and handoffs.",
    votable: true,
    items: itemsForMilestone(roadmap, "planned", "v2.2").map((item) => ({
      id: item.id,
      title: item.title,
      blurb: item.blurb,
    })),
  },
  {
    version: "v2.3",
    id: "v2-3",
    title: "Discovery and pipeline depth",
    timing: "voting open",
    summary:
      "Strengthen the pipeline before implementation with sharper problem discovery, opportunity framing, and evaluator evidence.",
    votable: true,
    items: itemsForMilestone(roadmap, "planned", "v2.3").map((item) => ({
      id: item.id,
      title: item.title,
      blurb: item.blurb,
    })),
  },
];
---

<Base
  title="Changelog · opchain"
  description="Release notes for opchain — what shipped, when, and how to migrate. Plus what's shipping next and the live, votable roadmap."
  active="/changelog"
>
  <main class="page">
    <div class="page-head">
      <span class="eyebrow">changelog</span>
      <h1>Changelog.</h1>
      <p class="lede">
        What shipped, what's next, and what to do about it. Each skill's
        <code>version</code> field is the source of truth — this page rolls
        them up by release. Vote on what's coming to signal priority.
      </p>
    </div>

    <!-- ══ TAB BAR ══════════════════════════════════════════ -->
    <div class="tab-bar">
      <div class="tab-list" role="tablist" aria-label="Changelog sections" data-changelog-tabs>
        <button
          class="tab-btn"
          role="tab"
          id="tab-released"
          aria-controls="panel-released"
          aria-selected="true"
          tabindex="0"
        >
          Just Released <span class="tab-count">18 shipped</span>
        </button>
        <button
          class="tab-btn tab-btn--next"
          role="tab"
          id="tab-coming"
          aria-controls="panel-coming"
          aria-selected="false"
          tabindex="-1"
        >
          Coming Next <span class="tab-count">v2.0</span>
        </button>
        <button
          class="tab-btn tab-btn--planned"
          role="tab"
          id="tab-planned"
          aria-controls="panel-planned"
          aria-selected="false"
          tabindex="-1"
        >
          Planned <span class="tab-count">v2.1 → v2.3</span>
        </button>
      </div>
      <span class="tab-indicator" data-tab-indicator aria-hidden="true"></span>
    </div>

    <!-- ══ PANEL 0 — JUST RELEASED ═══════════════════════════ -->
    <section
      class="tab-panel"
      role="tabpanel"
      id="panel-released"
      aria-labelledby="tab-released"
      tabindex="0"
    >
      <div class="panel-head">
        <h2>What shipped</h2>
        <span class="panel-sub">Latest release is open; patches and earlier releases expand in place.</span>
      </div>

      <!-- v1.9 — latest shipped release; "Assurance and governed delivery ops". Deep-linkable from #v1-9. -->
      <article class="hero-card hero-card--released is-open" id="v1-9" data-card>
        <button
          class="hero-head"
          type="button"
          aria-expanded="true"
          aria-controls="v1-9-body"
          data-disclosure-toggle
        >
          <span class="hero-chevron" aria-hidden="true">▶</span>
          <span class="hero-badge">latest release</span>
          <span class="hero-ver">v1.9.0 · shipped Sep 02, 2026</span>
          <span class="hero-title">Assurance and governed delivery ops</span>
          <span class="hero-desc">
            Delivery evidence you can review and enforce. v1.9 adds four skills
            that decide which tests should exist, build data pipelines with
            observable contracts, keep a standing compliance register with
            audit-ready evidence, and execute security fixes behind a per-deploy
            gate — each activated by a file in the repo, inert without it.
          </span>
        </button>
        <div class="card-body" id="v1-9-body" data-disclosure-body>
          <div class="card-body-inner hero-body-inner">
            <div class="tag-row"><span class="tag tag--accent">shipped</span><span class="tag">29 → 33 skills</span><span class="tag">4 new skills</span><span class="tag">additive</span></div>
            <h3>What&rsquo;s new</h3>
            <div class="tile-grid">
              <div class="tile">
                <span class="tile-name">oc-qa-ops</span>
                <span class="tile-desc">Test-pyramid design: coverage budgets, contract-test matrix, load-test planning. The strategy layer split out of oc-bug-check, which now reads its budgets at the commit gate.</span>
              </div>
              <div class="tile">
                <span class="tile-name">oc-data-ops</span>
                <span class="tile-desc">Ingestion patterns, staging → intermediate → marts layering, dbt, and data contracts replayed by an isolated Contract-Verifier — schema, freshness, volume, invariants.</span>
              </div>
              <div class="tile">
                <span class="tile-name">oc-compliance-ops</span>
                <span class="tile-desc">A standing control register plus audit-ready evidence bundles generated at deploy and release time. Evidence, not certification.</span>
              </div>
              <div class="tile">
                <span class="tile-name">oc-security-hardening</span>
                <span class="tile-desc">The execution half of the security pair: turns auditor findings into merged fixes, records every control in a manifest, and stands the per-deploy gate that replays it.</span>
              </div>
            </div>
            <div class="compat-box">
              <strong>Skill and on-disk checkpoint compatibility:</strong>
              back-compatible with v1.8.3. All 33 skills lockstep-bump to
              <code>1.9.0</code>; no checkpoint-file migration or commands are
              removed. All MCP checkpoint callers must first use
              <code>create_checkpoint_session</code>; invented tokens and the
              former shared <code>default</code> session are rejected. The 16
              pre-v1.9 hosted checkpoint records are deleted during rollout;
              local on-disk checkpoints are unaffected.
            </div>
          </div>
        </div>
      </article>

      <!-- v1.8 — latest shipped release; "Documentation & repo hygiene". Deep-linkable from #v1-8. -->
      <article class="hero-card hero-card--released" id="v1-8" data-card>
        <button
          class="hero-head"
          type="button"
          aria-expanded="false"
          aria-controls="v1-8-body"
          data-disclosure-toggle
        >
          <span class="hero-chevron" aria-hidden="true">▶</span>
          <span class="hero-badge">previous release</span>
          <span class="hero-ver">v1.8.0 → v1.8.3 · Jul 10 – Aug 27, 2026</span>
          <span class="hero-title">Documentation &amp; repo hygiene</span>
          <span class="hero-desc">
            Every PR should leave behind usable documentation, not just merged
            code. v1.8 adds the pair of skills that turn PR bodies, PR
            comments, READMEs, product docs, generated catalogs, and repo
            cleanliness into a standard gate on every PR — and wires the gate
            into the pipeline so it actually runs.
          </span>
        </button>
        <div class="card-body" id="v1-8-body" data-disclosure-body inert>
          <div class="card-body-inner hero-body-inner">
            <div class="tag-row"><span class="tag tag--info">shipped</span><span class="tag">Jul 10, 2026</span><span class="tag">27 → 29 skills</span></div>
            <p>
              Every PR now runs the documentation mesh in order:
              <strong>oc-docs-forge</strong> writes the documentation packet,
              <strong>oc-repo-ops</strong> verifies it and the repository around
              it, <strong>oc-bug-check</strong> runs the fast code gate, and
              only then does <strong>oc-git-ops</strong> open the PR. The skill
              that writes the docs never decides whether they're good enough.
            </p>
            <h3>Two new skills</h3>
            <div class="tile-grid">
              {v18Skills.map((skill) => (
                <div class="tile">
                  <span class="tile-name">{skill.name} · {skill.command}</span>
                  <p class="tile-desc">{skill.blurb}</p>
                </div>
              ))}
            </div>
            <div class="callout">
              <h3>Every-PR contract</h3>
              <ul class="callout-list">
                <li><strong>PR body and comments:</strong> every PR body carries a <code>## Documentation</code> section — "no docs needed" requires evidence — plus, when the packet runs long, a durable PR comment under a stable marker.</li>
                <li><strong>README and product docs:</strong> the repo-facing and product-facing docs that changed behavior makes stale are updated from the actual diff, not from memory.</li>
                <li><strong>Repo readiness:</strong> generated files, docs catalogs, release surfaces, ignore rules, and dirty related files are verified before PR handoff — fail closed.</li>
              </ul>
            </div>
            <div class="planned-box">Read the story: <a href="/blog/2026-07-10-v1-8-documentation-and-repo-hygiene">the release post</a> and <a href="/blog/2026-07-10-the-docs-bot-doesnt-grade-its-own-homework">the engineering deep-dive</a>.</div>
            <div class="compat-box">
              <strong>Back-compatible with v1.7.</strong> All 29 skills
              lockstep-bump to <code>1.8.0</code>; the two new skills ship gated
              behind their <code>skills.registry.&lt;id&gt;.enabled</code> flags,
              and no documented cross-skill contract was removed — the every-PR
              gate is additive wiring in oc-git-ops.
            </div>
          </div>
        </div>
      </article>

      <!-- v1.8.2 — the plugin patch under the v1.8 line. Deep-linkable from #v1-8-2. -->
      <article class="rel-card" id="apache-2" data-card>
        <button class="rc-row" type="button" aria-expanded="false" aria-controls="apache-2-body" data-disclosure-toggle>
          <span class="rc-toggle" aria-hidden="true">▶</span>
          <span class="rc-meta">
            <span class="rc-head"><span class="ver-pill ver-pill--past">licensing</span><span class="rc-title">Apache-2.0, everywhere it ships</span><span class="rc-date">Aug 25, 2026</span></span>
            <span class="rc-summary">The catalog relicensed from MIT to Apache-2.0 — and the license now travels inside every artifact: both zip bundles, the docs tree, /LICENSE on this site, and the machine-readable catalogs.</span>
          </span>
        </button>
        <div class="card-body" id="apache-2-body" data-disclosure-body inert>
          <div class="card-body-inner">
            <div class="tag-row"><span class="tag">Apache-2.0</span><span class="tag">LICENSE + NOTICE</span><span class="tag">every artifact</span></div>
            <p>
              Every <code>SKILL.md</code> now declares <code>license: Apache-2.0</code>
              (releases up to v1.8.2 were published under the old license). The change
              is bigger than the LICENSE file: the combined and per-skill zips carry
              <code>LICENSE</code> + <code>NOTICE</code> inside the artifact,
              <a href="/LICENSE">/LICENSE</a> is served from this site, and
              <code>/skills.json</code>, <code>/llms.txt</code> and the MCP server card
              declare the license — so a compliance scanner can establish the terms
              from whatever it actually downloaded.
            </p>
          </div>
        </div>
      </article>
      <!-- v1.8.3 — the release-ledger patch under the v1.8 line. Deep-linkable from #v1-8-3.
           Licensing is deliberately NOT re-told here: the #apache-2 topical card above owns
           that story (RELEASING.md §4 rule 4). This card links to it instead. -->
      <article class="rel-card" id="v1-8-3" data-card>
        <button class="rc-row" type="button" aria-expanded="false" aria-controls="v1-8-3-body" data-disclosure-toggle>
          <span class="rc-toggle" aria-hidden="true">&#9654;</span>
          <span class="rc-meta">
            <span class="rc-head"><span class="ver-pill ver-pill--past">v1.8.3 patch</span><span class="rc-title">Open seams, closed ledger</span><span class="rc-date">Aug 27, 2026</span></span>
            <span class="rc-summary">A release that skips its git tag can no longer reach production &mdash; plus the repository seams that let the skills tree ship on its own.</span>
          </span>
        </button>
        <div class="card-body" id="v1-8-3-body" data-disclosure-body inert>
          <div class="card-body-inner">
            <div class="tag-row"><span class="tag">release ledger</span><span class="tag">OSS seams</span><span class="tag">60&rarr;6 alerts</span><span class="tag">29 skills</span></div>
            <h3>The release ledger closes</h3>
            <p>
              An audit compared this page to <code>git tag</code> and found
              <strong>thirteen shipped releases and three tags</strong>. v1.0 through
              v1.7 all shipped untagged &mdash; and because the MCP-registry publisher
              triggers on <code>v*</code> tags, ten releases never republished the
              registry pointer.
            </p>
            <p>
              The cause was structural. Release Ops handed off &ldquo;the merge /
              tag&rdquo; to <a href="/skills/oc-git-ops">Git Ops</a> &mdash;
              <strong>a skill with no tag verb</strong>. The handoff named a step that
              did not exist, and nothing checked whether it happened.
            </p>
            <ul>
              <li><strong><code>/oc-git-release</code></strong> gives Git Ops the tag it was always supposed to cut. It refuses an unmerged HEAD, a version that disagrees with the catalog, or a tag that already exists.</li>
              <li><strong>The deploy refuses.</strong> A production deploy is blocked when the catalog version has moved somewhere no tag follows. It reads the lockstep skill version, so content deploys never trip it.</li>
              <li><strong>One check, two callers.</strong> The release verify step and the deploy path run the same script, so the check you run and the check that blocks you cannot drift apart.</li>
              <li><strong>A daily backstop</strong> tracks any shipped release still missing a tag &mdash; catching what the gate cannot, like a tag made locally and never pushed.</li>
            </ul>
            <h3>Repository seams</h3>
            <p>
              Five changes let the skills tree build and ship independently of the
              site tooling: input-path overrides for every skills-tree reader, flag
              validation split out of the product validator, internal identifiers
              scrubbed from shipped text, the site building against a vendored skills
              tree, and the plugin&rsquo;s skills directory materialised. Groundwork
              for making the public repository the primary one.
            </p>
            <h3>Also in this patch</h3>
            <ul>
              <li>The roadmap on this page is sourced from <strong>GitHub Issues instead of Linear</strong>, with contact details kept out of public issues.</li>
              <li>Vulnerability reports become security incidents rather than ordinary issues.</li>
              <li>Scrollable code blocks on <a href="/install">/install</a> and elsewhere are keyboard-focusable.</li>
              <li>Open dependency alerts cut from <strong>60 to 6</strong>, including a move to Astro 7.</li>
              <li>Licensing moved to Apache-2.0 &mdash; see <a href="#apache-2">Apache-2.0, everywhere it ships</a> above.</li>
            </ul>
            <div class="compat-box">
              <strong>Back-compatible with v1.8.2.</strong> All 29 skills lockstep-bump
              to <code>1.8.3</code>. No checkpoint migration; no commands or routes
              removed. The one behavioural change is that a production deploy now
              refuses an untagged release &mdash; deliberate, and overridable out loud.
            </div>
          </div>
        </div>
      </article>
      <article class="rel-card" id="v1-8-2" data-card>
        <button class="rc-row" type="button" aria-expanded="false" aria-controls="v1-8-2-body" data-disclosure-toggle>
          <span class="rc-toggle" aria-hidden="true">▶</span>
          <span class="rc-meta">
            <span class="rc-head"><span class="ver-pill ver-pill--past">v1.8.2 patch</span><span class="rc-title">Enforcement that ships</span><span class="rc-date">Jul 24, 2026</span></span>
            <span class="rc-summary">opchain now installs as a Claude Code plugin carrying executable hooks — a commit gate that actually blocks, session state you don't have to ask for, and a nudge toward the next skill when one finishes.</span>
          </span>
        </button>
        <div class="card-body" id="v1-8-2-body" data-disclosure-body inert>
          <div class="card-body-inner">
            <div class="tag-row"><span class="tag">plugin install</span><span class="tag">commit gate</span><span class="tag">honesty pass</span><span class="tag">29 skills</span></div>
            <p>
              The catalog used to describe gates it could not enforce. Everything it
              shipped was markdown, so an instruction like &ldquo;always run bug-check
              before committing&rdquo; was a request, not a rule &mdash; and across 87
              measured sessions, cross-skill auto-invocation fired
              <strong>zero times</strong>. This patch ships the mechanism instead of
              the description.
            </p>
            <h3>New: install as a plugin</h3>
            <div class="planned-box">
              <code>/plugin marketplace add asfbay-bit/opchain-skills</code><br />
              <code>/plugin install opchain</code>
            </div>
            <p>
              The skills-only zip still works and is unchanged. The plugin adds what
              markdown can't carry:
            </p>
            <ul>
              <li><strong>A commit gate that blocks.</strong> <code>git commit</code> is refused unless oc-bug-check recorded a pass bound to the exact code being committed &mdash; so a stale or hand-written verdict doesn't count.</li>
              <li><strong>Session state, unprompted.</strong> Stale checkpoints, open findings and the next action are computed at session start instead of waiting to be asked for.</li>
              <li><strong>A pointer to the next skill.</strong> When a skill finishes, the one to run next is named as something you can type. It fires on real transitions, not on standing state, and stays quiet otherwise.</li>
            </ul>
            <h3>Honesty pass</h3>
            <p>
              Every <code>Auto-invokes X</code> and <code>Trigger liberally</code> claim
              is gone from all 29 skills and the shared orchestrator protocol. They
              described a chaining mechanism that had never once fired on its own.
              oc-git-ops also stops claiming a hook that existed in exactly one
              repository while shipping to everyone.
            </p>
            <h3>Fixed</h3>
            <ul>
              <li><strong>oc-bug-check</strong> gained Swift support and an <code>UNSUPPORTED</code> verdict distinct from pass &mdash; an unrecognised stack used to report green on code it never read. Secret scanning no longer skips non-JavaScript files.</li>
              <li><strong>Checkpoint staleness</strong> now covers <code>complete</code> checkpoints, not just in-progress ones; a finished checkpoint asserting a long-shipped release drew no warning for a month.</li>
              <li><strong>Next-action drift</strong> &mdash; the two highest-priority paths skipped the already-shipped filter entirely, which is how the tool recommended tagging a release that had shipped twelve days earlier.</li>
            </ul>
            <div class="compat-box">
              <strong>Back-compatible with v1.8.1.</strong> All 29 skills lockstep-bump
              to <code>1.8.2</code>. No checkpoint migration, no routes or commands
              removed; the plugin is an additive install channel.
            </div>
          </div>
        </div>
      </article>

      <!-- v1.8.1 — checkpoint-truth patch under the v1.8 line. Deep-linkable from #v1-8-1. -->
      <article class="rel-card" id="v1-8-1" data-card>
        <button class="rc-row" type="button" aria-expanded="false" aria-controls="v1-8-1-body" data-disclosure-toggle>
          <span class="rc-toggle" aria-hidden="true">▶</span>
          <span class="rc-meta">
            <span class="rc-head"><span class="ver-pill ver-pill--past">v1.8.1 patch</span><span class="rc-title">Checkpoint truth without the CLI</span><span class="rc-date">Jul 12, 2026</span></span>
            <span class="rc-summary">Consumer repos no longer lose trustworthy project status just because they don't carry opchain.dev's optional checkpoint CLI — the checkpoint files themselves are the source of truth.</span>
          </span>
        </button>
        <div class="card-body" id="v1-8-1-body" data-disclosure-body inert>
          <div class="card-body-inner">
            <div class="tag-row"><span class="tag">checkpoint reads</span><span class="tag">no repo-local CLI</span><span class="tag">corroborated status</span><span class="tag">29 skills</span></div>
            <p>
              The checkpoint protocol was leaning on an optional in-repo
              scaffolder that installed skill bundles don't ship. This patch
              makes a direct read of <code>.checkpoints/*.checkpoint.json</code>
              the authoritative path, so "where did I leave off?" answers the
              same in a consumer repo as it does here — and insists that answer
              be checked against reality, not taken on faith.
            </p>
            <h3>What shipped</h3>
