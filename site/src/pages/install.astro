---
import Base from "../layouts/Base.astro";
import { UPGRADE_PROMPT } from "../data/upgrade-prompt";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Icon from "../components/Icon.astro";
import CaptureModal from "../components/CaptureModal.astro";
import RouterLabel from "../components/RouterLabel.astro";
import { ROUTER_LIVE_MODE } from "../data/router-status";
import { defaultFor } from "../lib/flags/build-defaults";

const installZipEnabled = defaultFor("site.feature.install-zip-download") as boolean;
const codexInstallEnabled = defaultFor("site.feature.codex-install") as boolean;

const installDesc = codexInstallEnabled
  ? "Install opchain in Claude Code, Claude.ai, Claude Desktop, or Codex / any MCP agent — complete skill folders or a hosted MCP endpoint. No API keys required."
  : "Install opchain in Claude Code, Claude.ai, or Claude Desktop. Three flows, complete skill folders. No API keys required.";

const cliCmd = `curl -L https://opchain.dev/opchain-skills.zip -o opchain-skills.zip
unzip opchain-skills.zip -d .claude/skills/
claude
> /oc-discover`;

const teamCmd = `git add .claude/skills/
git commit -m "chore: add opchain skills"
git push`;

const upgradeCmd = `installer=$(mktemp -t opchain-update)
curl --fail --location https://opchain.dev/update.mjs -o "$installer" &&
node "$installer" --target=claude
rm -f "$installer"`;

const versionCmd = `/oc-update check`;

// SessionStart update check: compares the installed SKILL.md frontmatter
// version (project install first, then global) against the lockstep
// `catalogVersion` in /skills.json. Prints one line when an update exists;
// silent — no output, exit 0 — when current, offline, or opchain isn't
// installed. Serialized with JSON.stringify so the snippet users copy is
// guaranteed-valid settings.json.
const updateHookCmd = `f=$(ls "\${CLAUDE_PROJECT_DIR:-.}"/.claude/skills/oc-*/SKILL.md "$HOME"/.claude/skills/oc-*/SKILL.md 2>/dev/null | head -n1); [ -n "$f" ] || exit 0; installed=$(sed -n 's/^version:[[:space:]]*//p' "$f" | head -n1); [ -n "$installed" ] || exit 0; latest=$(curl -sf --max-time 3 "https://opchain.dev/skills.json?u=$(date +%s)" | sed -n 's/.*"catalogVersion": *"\\([^"]*\\)".*/\\1/p' | head -n1); [ -n "$latest" ] && [ "$installed" != "$latest" ] && echo "opchain skills v$latest is available (installed: v$installed). Update guide: https://opchain.dev/install#update"; exit 0`;
const updateHookJson = JSON.stringify(
  {
    hooks: {
      SessionStart: [
        {
          matcher: "startup",
          hooks: [{ type: "command", command: updateHookCmd }],
        },
      ],
    },
  },
  null,
  2,
);

const codexMcpCmd = `# ~/.codex/config.toml
[mcp_servers.opchain]
url = "https://opchain.dev/mcp"`;

const upgrade20Cmd = `/oc-update check
/oc-update`;
// Installing the plugin installs no gate (true since 1.9.2): the plugin's
// registered hooks are SessionStart and Stop only, and the Git pre-commit
// gate is installed per repository by /oc-enroll (plugins/opchain/README.md,
// "The gates"). Maintainer correction, Track S S0.
const pluginCmd = `/plugin marketplace add asfbay-bit/opchain-skills
/plugin install opchain
/oc-enroll`;

// 2.1 enforcement (docs/plans/2026-10-09-v2.1-site-update.md). Installing the
// plugin installs no gate; /oc-enroll does, once per repository. Modes per
// plugins/opchain/commands/oc-enroll.md on the 2.1 branch.
const enrollCmd = `/oc-enroll              # install the hooks (2.0.4: pre-commit only)
/oc-enroll --doctor     # installs nothing; PASS/FAIL per item
/oc-enroll --ci         # add the pull-request evidence workflow (commit it)
/oc-enroll --claude-md  # write this repo's opchain verbs into CLAUDE.md`;

const bypassCmd = `git commit --amend --no-verify \\
  --trailer "Opchain-Bypass: <who approved, what failed>"`;

// Skill router opt-in (router release term 5; plugins/opchain/hooks/route-prompt.cjs).
// Live mode is not in the copy block: OPCHAIN_ROUTE_MODE=live is unsupported
// until the shadow-period go/no-go records a GO (term 4).
const routerCmd = `# 1. get a key from TypeSafe; calls are made with your key,
#    under your TypeSafe account and its terms
# 2. set it where Claude Code starts: the router runs in shadow mode
export TYPESAFE_API_KEY=...
# 3. read what it would have suggested
tail -n 20 "$TMPDIR/opchain-route-log.jsonl"
# turn it off: unset the key, or
export OPCHAIN_ROUTE=0`;

const codexSkillsCmd = `curl -L https://opchain.dev/opchain-skills.zip -o opchain-skills.zip
unzip opchain-skills.zip -d .agents/skills/
codex`;
---

<Base
  title="Install · opchain"
  description={installDesc}
  active="/install"
>
  <main class="page">
    <div class="page-head">
      <div>
        <Eyebrow>install</Eyebrow>
        <h1>{codexInstallEnabled ? "Four" : "Three"} flows.</h1>
      </div>
      {installZipEnabled && (
        <Button
          variant="primary"
          href="/opchain-skills.zip"
          {...{ "data-capture-trigger": true, "data-capture-source": "bundle-download" } as any}
        >
          <Icon name="download" />
          download bundle
        </Button>
      )}
    </div>

    <section class="upgrade-prompt" aria-labelledby="upgrade-prompt-title">
      <h2 id="upgrade-prompt-title">Using Opchain 1.9 or earlier?</h2>
      <p>Paste this into your coding agent with your project open. It checks your installation and installs the updater for you.</p>
      <button class="copy upgrade-prompt-copy" type="button" data-copy={UPGRADE_PROMPT} data-flow="upgrade-prompt" data-copy-status="upgrade-copy-status" aria-label="Copy upgrade prompt">
        <Icon name="copy" size={16} />
        <span class="copy-label">Copy upgrade prompt</span>
      </button>
      <p id="upgrade-copy-status" class="upgrade-copy-status" role="status" aria-live="polite"></p>
      <details id="upgrade-prompt-details">
        <summary>Read the upgrade prompt</summary>
        <pre class="codeblock upgrade-prompt-text" tabindex="0" role="region" aria-label="Upgrade prompt text">{UPGRADE_PROMPT}</pre>
      </details>
    </section>

    <p class="lede">
      Each skill includes a <code class="ic">SKILL.md</code> file and its supporting files.
      Install complete folders so references and runtime commands work.
      The local runtime needs Node.js 22.13 or newer.
    </p>

    <!-- ───────────── Flow 1 — Claude Code ───────────── -->
    <section class="flow">
      <div class="flow-num">01</div>
      <div class="flow-body">
        <h2><Icon name="terminal" /> Claude Code CLI</h2>
        <p>
          Need the CLI first?
          <a href="https://claude.com/claude-code" rel="noopener">
            Install Claude Code
          </a>, then pick a path. The <strong>plugin</strong> is the one to
          use if you can — it carries the skills, the session hooks,
          <em>and</em> <code class="ic">/oc-enroll</code>, which installs the
          commit gate. The zip carries the skills only.
        </p>

        <h3 class="flow-sub">Plugin <span class="flow-tag">recommended</span></h3>
        <p>
          Two commands install it; the third turns on the gate. The plugin adds
          the 36 skills, sixteen registered slash commands, pipeline state at
          session start, and a pointer to the next skill when one finishes.
          <strong>Installing the plugin installs no gate.</strong> Run
          <code class="ic">/oc-enroll</code> in each repository: it installs a
          Git <code class="ic">pre-commit</code> hook that refuses a commit
          unless the exact staged code passed the checks in
          <code class="ic">.bugcheck.json</code>. Until enrollment succeeds,
          nothing checks your commits.
          <a href="#enroll">What enrollment installs</a>.
        </p>
        <div class="code-row">
          <pre class="codeblock" tabindex="0" role="region" aria-label="Plugin install commands"><code>{pluginCmd}</code></pre>
          <button class="copy" type="button" data-copy={pluginCmd} data-flow="plugin" aria-label="Copy command">
            <Icon name="copy" size={12} />
            <span class="copy-label">copy</span>
          </button>
        </div>

        <h3 class="flow-sub">Zip <span class="flow-tag flow-tag--muted">skills only</span></h3>
        <p>
          Drop the skills into <code class="ic">.claude/skills/</code>; Claude
          Code discovers them next session. Use this where a plugin install
          isn't an option. Note what it does <em>not</em> include: none of the
          hooks, so nothing mechanically enforces a gate — the skills describe
          the contract and you follow it.
        </p>
        <div class="code-row">
          <pre class="codeblock" tabindex="0" role="region" aria-label="CLI install commands"><code>{cliCmd}</code></pre>
          <button class="copy" type="button" data-copy={cliCmd} data-flow="cli" aria-label="Copy command">
            <Icon name="copy" size={12} />
            <span class="copy-label">copy</span>
          </button>
        </div>
        <p class="verify">
          <strong>Verify it worked.</strong> In that session, type
          <code class="ic">/oc-discover</code>. If oc-app-architect starts an
          interview ("Who's the primary user? Sync or async? …"), you're
          set. If not, re-check that the files landed in
          <code class="ic">.claude/skills/&lt;name&gt;/SKILL.md</code>.
        </p>
      </div>
    </section>

    <!-- ───────────── Flow 2 — Claude.ai / Desktop ───────────── -->
    <section class="flow">
      <div class="flow-num">02</div>
      <div class="flow-body">
        <h2><Icon name="layers" /> Claude.ai / Claude Desktop</h2>
        <ol class="steps">
          <li>
            {installZipEnabled ? (
              <>Download the full <a href="/opchain-skills.zip">bundle ZIP</a> with complete skill folders from the <a href="/skills">Skill Library</a>.</>
            ) : (
              <>Read the skill instructions from the <a href="/skills">Skill Library</a>.</>
            )}
          </li>
          <li>Use your host’s supported skill import flow.</li>
          <li>Keep each skill’s supporting files with it. Local runtime commands need filesystem access and Node.js 22.13 or newer; loading instructions alone does not run those commands.</li>
          <li>
            Start a new conversation and name the skill
            (<em>"use oc-app-architect — I have an app idea"</em>) or use its
            slash command (<code class="ic">/oc-discover</code>). Naming it
            explicitly is markedly more reliable than hoping the description
            matches.
          </li>
        </ol>
      </div>
    </section>

    <!-- ───────────── Flow 3 — Team / git ───────────── -->
    <section class="flow">
      <div class="flow-num">03</div>
      <div class="flow-body">
        <h2><Icon name="github" /> Team (check into git)</h2>
        <p>Commit the skills directory so every teammate uses the same prompt pipeline.</p>
        <div class="code-row">
          <pre class="codeblock" tabindex="0" role="region" aria-label="Team git commands"><code>{teamCmd}</code></pre>
          <button class="copy" type="button" data-copy={teamCmd} data-flow="team" aria-label="Copy command">
            <Icon name="copy" size={12} />
            <span class="copy-label">copy</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ───────────── Flow 4 — Codex / any MCP agent ───────────── -->
    {codexInstallEnabled && (
      <section class="flow">
        <div class="flow-num">04</div>
        <div class="flow-body">
          <h2><Icon name="terminal" /> Codex / any MCP agent</h2>
          <p>
            Codex — and any MCP-aware agent (Claude Desktop, Cursor, Windsurf) —
            reaches opchain two ways, over the
            <a href="https://modelcontextprotocol.io" rel="noopener">Model Context Protocol</a>
            or as drop-in skills. The drop-in path is the closest match to Claude
            Code: Codex Agent Skills auto-trigger by description, so the pipeline
            fires on its own. The hosted MCP endpoint needs no install, but relies
            on the model choosing to call opchain's tools.
          </p>
          <p class="flow-sub">
            <strong>Drop the skills in (recommended)</strong> — Codex Agent Skills
            use the same <code class="ic">SKILL.md</code> format and auto-trigger by
            description — the same unenforced, name-it-yourself matching Claude
            Code skills rely on:
          </p>
          <div class="code-row">
            <pre class="codeblock" tabindex="0" role="region" aria-label="Codex skills install commands"><code>{codexSkillsCmd}</code></pre>
            <button class="copy" type="button" data-copy={codexSkillsCmd} data-flow="codex-skills" aria-label="Copy Codex skills install">
              <Icon name="copy" size={12} />
              <span class="copy-label">copy</span>
            </button>
          </div>
          <p class="flow-sub">
            <strong>Or point Codex at the hosted MCP server</strong> — nothing to
            install; works for any MCP client:
          </p>
          <div class="code-row">
            <pre class="codeblock" tabindex="0" role="region" aria-label="Codex MCP server config"><code>{codexMcpCmd}</code></pre>
            <button class="copy" type="button" data-copy={codexMcpCmd} data-flow="codex-mcp" aria-label="Copy Codex MCP config">
              <Icon name="copy" size={12} />
              <span class="copy-label">copy</span>
            </button>
          </div>
          <p class="verify">
            <strong>Verify it worked.</strong> Run <code class="ic">codex</code>
            and ask "build me an app" — a drop-in skill match (or, over the hosted
            server, opchain's <code class="ic">route</code> tool) hands you to
            oc-app-architect's discovery interview. Note: Codex doesn't surface MCP
            prompts, so opchain's <code class="ic">/oc-*</code> verbs aren't slash
            commands in Codex — just describe what you want ("build me an app",
            "audit this") and the matching skill triggers.
          </p>
        </div>
      </section>
    )}

    <!-- ───────────── Enrollment: the gate (2.1) ───────────── -->
    <section class="gate" id="enroll">
      <Eyebrow>enforcement</Eyebrow>
      <h2><Icon name="shield" /> Turn on the gate: <code class="ic">/oc-enroll</code></h2>
      <p>
        Skills describe the pipeline; they cannot make another skill run. What
        holds is a check at the place the work goes through: the commit, the
        push, the pull request, the deploy. With the plugin, those checks live
        in Git hooks, and Git hooks are per repository. A repository that is
        not enrolled has the skills and none of the checks. We measured one
        that ran seven days and 193 commits like that.
      </p>
      <p class="verify">
        On 2.0.4, <code class="ic">/oc-enroll</code> installs the <code class="ic">pre-commit</code>
        hook. Items marked <span class="gate-tag">New in 2.1</span> arrive
        with the 2.1 release.
      </p>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Enrollment commands"><code>{enrollCmd}</code></pre>
        <button class="copy" type="button" data-copy={enrollCmd} data-flow="enroll" aria-label="Copy enrollment commands">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <ul class="gate-list">
        <li><strong><code class="ic">--doctor</code></strong> <span class="gate-tag">New in 2.1</span> installs nothing and prints one PASS/FAIL line per item that decides whether the gate will run here: enrollment, the verifier runtime, each hook, the <code class="ic">.bugcheck.json</code> <code class="ic">verification</code> block, whether every declared command resolves, and whether <code class="ic">node_modules/</code> is a real install rather than a leftover cache. Run it on a fresh worktree, or when a check fails with exit 127.</li>
        <li><strong><code class="ic">--ci</code></strong> <span class="gate-tag">New in 2.1</span> copies the verifier into <code class="ic">.opchain/runtime/</code> and writes <code class="ic">.github/workflows/opchain-evidence.yml</code>. Commit both. Every pull request then re-runs the checks on the head it actually received and requires the docs and readiness evidence; local hooks can be skipped, this cannot. It never overwrites an existing workflow without <code class="ic">--force</code>.</li>
        <li><strong><code class="ic">--claude-md</code></strong> <span class="gate-tag">New in 2.1</span> adds a marked section to <code class="ic">CLAUDE.md</code> naming this repository's verbs (<code class="ic">/oc-commit</code>, <code class="ic">/oc-pr</code>, <code class="ic">/oc-deploy</code>, <code class="ic">/oc-bugcheck</code>) and the rule that <code class="ic">--no-verify</code> never happens without <code class="ic">/oc-bugcheck bypass</code>.</li>
      </ul>
      <p class="verify">
        <strong>An existing hook manager?</strong> Enrollment refuses to
        overwrite a hook it did not write. It prints the snippet to add to
        yours, and the gate is not on until your hook manager runs it.
      </p>

      <h3><Icon name="terminal" /> What the hooks do</h3>
      <ul class="gate-list">
        <li><strong><code class="ic">pre-commit</code></strong> re-runs the checks in <code class="ic">.bugcheck.json</code> on the exact staged tree in an isolated checkout and writes a <a href="/glossary#receipt">receipt</a>. PASS lets the commit through. FAIL blocks it and prints each failing check with its exit code and the end of its output; the full log sits next to the receipt.</li>
        <li><strong>Timeouts and broken environments are not failures.</strong> <span class="gate-tag">New in 2.1</span> A check that times out, or exits 127 because a command was not found, comes back <a href="/glossary#inconclusive">INCONCLUSIVE</a>: retry it, there is nothing to fix in the code. Missing dependencies are BLOCKED, with no receipt written: run <code class="ic">npm ci</code> and commit again. An identical tree, or one that changed only <code class="ic">.checkpoints/</code>, reuses its PASS receipt. Two worktrees committing at once take turns.</li>
        <li><strong><code class="ic">post-commit</code></strong> <span class="gate-tag">New in 2.1</span> runs even under <code class="ic">--no-verify</code>. When a commit has no PASS receipt it writes a <a href="/glossary#bypass-record">bypass record</a> under <code class="ic">.git/opchain/bypasses/</code> and prints a warning naming the commit.</li>
        <li><strong><code class="ic">pre-push</code></strong> <span class="gate-tag">New in 2.1</span> refuses to push a commit that has neither a PASS receipt nor an <code class="ic">Opchain-Bypass:</code> trailer, and lists the commits. A commit a rebase or cherry-pick produced is excused only if the original commit had a PASS receipt or an <code class="ic">Opchain-Bypass:</code> trailer. If it cannot work out which commits are outgoing (a force-push over commits you have not fetched, say), it refuses the push. <code class="ic">/oc-bugcheck bypass</code> writes the trailer, or amend by hand:</li>
      </ul>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Bypass trailer command"><code>{bypassCmd}</code></pre>
        <button class="copy" type="button" data-copy={bypassCmd} data-flow="bypass-trailer" aria-label="Copy bypass trailer command">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <p>
        <code class="ic">OPCHAIN_PUSH_BYPASS=1</code> on a push lets
        unaccounted commits through and prints which ones. Use it once, for
        history from before enrollment. Anyone with the repository
        can delete local hooks, which is why <code class="ic">--ci</code> exists.
      </p>
    </section>

    <!-- ───────────── Optional: skill router (2.1) ───────────── -->
    <section class="gate" id="router" data-router-copy>
      <Eyebrow>optional</Eyebrow>
      <h2><Icon name="target" /> Skill router <span class="gate-tag">New in 2.1 · opt-in</span> <RouterLabel /></h2>
      <p>
        A plugin hook that reads each prompt in an opchain project and asks
        TypeSafe&rsquo;s classifier which opchain skill, if any, owns it. It is
        off unless you set a key. With a key it runs in shadow mode: it logs
        the skill it would have named, on your machine, and adds nothing to
        the conversation. Its only evaluation so far is offline; whether it
        changes which skills get used is not measured yet.
      </p>
      <h3><Icon name="terminal" /> Opt in</h3>
      <ol class="gate-list">
        <li><strong>Get a key from TypeSafe.</strong> Calls are made with your key, under your TypeSafe account and its terms. Each routed prompt makes up to two requests, and decisions are cached on your machine for 24 hours.</li>
        <li><strong>Set <code class="ic">TYPESAFE_API_KEY</code></strong> in the environment Claude Code starts in.</li>
        <li><strong>Read the shadow log</strong> at <code class="ic">$TMPDIR/opchain-route-log.jsonl</code>: each prompt's decision and, on the next prompt, what the session actually did. Claude Code&rsquo;s <code class="ic">$TMPDIR</code> can differ from your shell&rsquo;s; set <code class="ic">OPCHAIN_ROUTE_LOG</code> to pin the path.</li>
      </ol>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Skill router opt-in commands"><code>{routerCmd}</code></pre>
        <button class="copy" type="button" data-copy={routerCmd} data-flow="router" aria-label="Copy skill router opt-in commands">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <p class="verify">
        <strong>Live mode</strong> (<code class="ic">OPCHAIN_ROUTE_MODE=live</code>) is {ROUTER_LIVE_MODE}; it would add the suggestion
        to the conversation as one line. 2.1.0 ships shadow mode as the
        default either way.
      </p>
      <div class="upg">
        <h3 class="upg-h">What leaves your machine <span class="upg-tag">third-party API</span></h3>
        <ul class="upg-list">
          <li>With <code class="ic">TYPESAFE_API_KEY</code> set, the hook sends the redacted prompt and a repo summary to <code class="ic">api.typesafe.ai</code>. The summary covers the branch name, ahead/behind, dirty count, open PR, enrollment, and the active checkpoint's skill, phase and first next action (up to 200 characters). Credential-shaped text is redacted; names in the branch or that next action are sent as written.</li>
          <li>The previous prompt and the end of the last assistant message are sent only with <code class="ic">OPCHAIN_ROUTE_CONTEXT=1</code>.</li>
          <li>Nothing is sent without a key, for slash commands, outside opchain projects, or for a typed <code class="ic">/oc-*</code> mention.</li>
          <li>Decisions are logged locally to <code class="ic">$TMPDIR/opchain-route-log.jsonl</code>.</li>
          <li>Unsetting the key or setting <code class="ic">OPCHAIN_ROUTE=0</code> turns it off.</li>
        </ul>
        <p class="upg-foot">
          <strong>Redaction first.</strong> Before anything is sent, logged or
          cached, text that looks like a credential is replaced with <code class="ic">[REDACTED]</code>:
          private keys, provider API keys and tokens, JWTs, bearer headers,
          long hex strings, and <code class="ic">*_KEY=</code> / <code class="ic">*_TOKEN=</code> / <code class="ic">*_SECRET=</code> / <code class="ic">*_PASSWORD=</code> assignments.
          If the redactor cannot load, nothing is sent. Pattern matching misses
          things; do not paste secrets into prompts. The classifier is
          TypeSafe&rsquo;s Jev model (<code class="ic">jev-1.13.0</code>,
          pinned); opchain.dev never sees the request.
        </p>
        <p class="upg-foot">
          <strong>Offline evaluation only.</strong> On 574 labelled prompts from past Claude Code sessions on one machine, in opchain and a consumer repository, each labelled by what the session did next
          (an offline evaluation, not a measurement of use), its suggestions had precision 0.92 for
          oc-git-ops and 0.88 for oc-deploy-ops. That set the thresholds it
          ships with; the method is in the source repo&rsquo;s <code class="ic">docs/runbooks/skill-router-eval.md</code>.
        </p>
      </div>
      <p>
        The router is a plugin hook; the zip install does not include it. More
        on what it sends: <a href="/privacy#router">privacy</a> and <a href="/security#plugin">security</a>.
      </p>
    </section>

    <!-- ───────────── Upgrade ───────────── -->
    <section class="upgrade" id="update">
      <Eyebrow>upgrade</Eyebrow>
      <h2><Icon name="refresh-cw" /> Update an existing install</h2>
      <p>
        Already running opchain in a project? Replace the skills in place.
        Your <code class="ic">.checkpoints/</code> directory lives
        <em>outside</em> <code class="ic">.claude/skills/</code>, so every
        skill's session state — phase, step, next actions, decisions — is
        preserved across the swap. The new skills pick up the existing
        checkpoints on their next invocation.
      </p>

      <!-- 2.0 content block 4 — what the next major means for an existing install -->
      <div class="upg">
        <h3 class="upg-h">Already on 1.x? <span class="upg-tag">Upgrade to 2.0</span></h3>
        <ul class="upg-list">
          <li><strong>Three new skills.</strong> The full set now includes 36 skills: oc-update, Hindsight and Evolve join the existing 33.</li>
          <li><strong>Complete files, one update.</strong> The updater replaces Opchain skill folders and their runtime files, backs up replaced files, and preserves checkpoints, telemetry consent and unrelated skills.</li>
          <li><strong>Learning starts off.</strong> Enable it separately for this project. Lessons and rules need review before use. Live evaluations send the selected tasks to your configured provider.</li>
          <li><strong>Plugin installations use the plugin manager.</strong> The repo updater does not change a global plugin installation or install hooks.</li>
        </ul>
        <pre class="codeblock" tabindex="0" role="region" aria-label="Upgrade to 2.0 commands"><code>{upgrade20Cmd}</code></pre>
        <p class="upg-foot">If 1.x does not recognize <code class="ic">/oc-update</code>, use the bootstrap installer below once. Run it from your project root with Node.js 22.13 or newer. For Codex, use <code class="ic">--target=codex</code>.</p>
      </div>

      <h3><Icon name="terminal" /> Claude Code CLI</h3>
      <p>
        Run from your project root. The installer checks the bundle, backs up replaced
        Opchain files and installs the current release.
      </p>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Upgrade command"><code>{upgradeCmd}</code></pre>
        <button class="copy" type="button" data-copy={upgradeCmd} data-flow="upgrade-cli" aria-label="Copy upgrade command">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <p class="verify">
        <strong>Verify the installation.</strong> Start a new agent session and run
        <code class="ic">/oc-update check</code>. It should report the installed
        release as current. Your saved checkpoints remain available.
      </p>

      <h3><Icon name="layers" /> Claude.ai / Claude Desktop</h3>
      <ol class="steps">
        <li>
          {installZipEnabled ? (
            <>Download the latest <a href="/opchain-skills.zip">bundle ZIP</a> with complete skill folders from the <a href="/skills">Skill Library</a>.</>
          ) : (
            <>Read the latest skill instructions from the <a href="/skills">Skill Library</a>.</>
          )}
        </li>
        <li>Use your host’s supported skill import flow.</li>
        <li>Replace each complete Opchain skill folder using your host’s supported import flow. Keep its references and runtime files together.</li>
        <li>Checkpoints in Claude.ai live in the project, not the skill, so they survive the upload.</li>
      </ol>

      <h3><Icon name="github" /> Team (git-tracked install)</h3>
      <p>
        If you committed <code class="ic">.claude/skills/</code> with the
        team flow, do the upgrade on a branch so the skill diff lands in
        review:
      </p>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Team upgrade commands"><code>{`git switch -c chore/upgrade-opchain
${upgradeCmd}
git diff --stat`}</code></pre>
      </div>
      <p>Review the changed Opchain files and install receipt before committing the update.</p>

      <h3><Icon name="target" /> Check which version you're on</h3>
      <div class="code-row">
        <pre class="codeblock" tabindex="0" role="region" aria-label="Version check command"><code>{versionCmd}</code></pre>
        <button class="copy" type="button" data-copy={versionCmd} data-flow="upgrade-version" aria-label="Copy version-check command">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <p>
        Checks the installed skills against the current release without changing files.
      </p>

      <h3><Icon name="zap" /> Get notified automatically</h3>
      <p>
        Skills don't phone home, so a stale install stays stale silently.
        This <a href="https://docs.claude.com/en/docs/claude-code/hooks" rel="noopener">Claude Code
        hook</a> checks at session start: it reads the
        <code class="ic">version</code> from your installed skills'
        frontmatter, compares it against the live catalog's
        <code class="ic">catalogVersion</code> at
        <code class="ic">opchain.dev/skills.json</code>, and drops a
        one-line notice into the session when a newer release is out.
        Merge it into <code class="ic">~/.claude/settings.json</code> (or a
        project's <code class="ic">.claude/settings.json</code>) — if you
        already have a <code class="ic">hooks</code> block, add the
        <code class="ic">SessionStart</code> entry to it rather than
        pasting the whole object.
      </p>
      <div class="code-row">
        {/* The hook command is one long line, so this block scrolls horizontally —
            it needs keyboard focus (axe: scrollable-region-focusable). */}
        <pre class="codeblock" tabindex="0" role="region" aria-label="Update-check hook for settings.json"><code>{updateHookJson}</code></pre>
        <button class="copy" type="button" data-copy={updateHookJson} data-flow="upgrade-hook" aria-label="Copy update-check hook settings">
          <Icon name="copy" size={12} />
          <span class="copy-label">copy</span>
        </button>
      </div>
      <p>
        It checks, it never installs — releases can carry breaking changes
        (see the <a href="/changelog">changelog</a>), so the swap stays a
        deliberate step: run the upgrade command above when you see the
        notice. When you're current, offline, or opchain isn't installed,
        the hook prints nothing and gets out of the way. It fires only on
        <code class="ic">startup</code> — not on resume or compact — and
        gives the network three seconds before giving up.
      </p>
