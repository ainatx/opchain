---
import { REPO_NEW_ISSUE } from "../lib/repo";
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import RouterLabel from "../components/RouterLabel.astro";
import { ROUTER_LIVE_MODE } from "../data/router-status";

interface Term {
  id: string;
  term: string;
  short: string;
  long?: string;
  /** Release that introduced the term, when it is newer than the current stamp. */
  since?: string;
  /** Skill-router copy: render the router status label (router release term 1). */
  router?: boolean;
  related?: Array<{ label: string; href: string }>;
}

const terms: Term[] = [
  {
    id: "skill",
    term: "Skill",
    short: "A single Markdown file that teaches Claude how to do one job — discover a product, audit a diff, ship a deploy.",
    long: "Lives at .claude/skills/<name>/SKILL.md. The frontmatter declares triggers, phase, and required flags; the body is the prompt Claude reads on invocation. Skills are inert by themselves — a host loads them and routes to them by name or slash command. Claude Code (or Claude.ai with Skills enabled) discovers them natively; Codex and any other MCP client reach the same catalog through opchain's hosted MCP endpoint.",
    related: [{ label: "Skill Library", href: "/skills" }, { label: "Install", href: "/install" }],
  },
  {
    id: "skillchain",
    term: "Skillchain",
    short: "The full set of opchain skills working together as a pipeline — discover → spec → design → build → audit → ship → monitor → migrate → scale.",
    long: "Skills hand work to each other across phase boundaries by writing to and reading from each other's checkpoints. A handoff written in a skill's text is a convention: a skill cannot make another skill run. The edges that must hold — commit, push, pull request, deploy — are held by a check at that chokepoint once the repository is enrolled. The architecture page's enforcement map lists which mechanism holds each one.",
    related: [{ label: "Enforcement map", href: "/architecture#enforcement-map" }, { label: "Enrollment", href: "/glossary#enrollment" }],
  },
  {
    id: "checkpoint",
    term: "Checkpoint",
    short: "JSON state file each skill writes to .checkpoints/<skill>.checkpoint.json after a meaningful step.",
    long: "Survives across sessions: phase, current step, progress table, blockers, decisions, next actions, and a two-sentence context primer. The next session reads them back so Claude picks up where you left off instead of re-asking everything.",
    related: [{ label: "oc-checkpoint-protocol", href: "/skills/oc-checkpoint-protocol" }],
  },
  {
    id: "oc-checkpoint-protocol",
    term: "Checkpoint protocol",
    short: "The contract every skill obeys when it reads or writes a checkpoint — same JSON shape, same fields, same lifecycle.",
    long: "Foundational skill, not invoked directly. Every other skill implements it so any skill can read any other's state without bespoke parsing. Validated in CI by npm run checkpoint:validate.",
    related: [{ label: "oc-checkpoint-protocol skill", href: "/skills/oc-checkpoint-protocol" }],
  },
  {
    id: "orchestrator",
    term: "Orchestrator",
    short: "Skill that recommends which skill should run next based on what you said, what phase you're in, and what the open checkpoints look like.",
    long: "Exposes /oc-ops — \"where did I leave off?\" Answers across every project on the machine. Reads every skill's checkpoint, writes its own pipeline state, and recommends the next skill. You still invoke it; it enforces nothing itself.",
    related: [{ label: "Architecture", href: "/architecture" }],
  },
  {
    id: "tri-agent",
    term: "Tri-agent loop",
    short: "A skill that runs three internal roles in sequence — Planner / Generator / Evaluator (or Auditor / Fixer / Verifier) — instead of one shot.",
    long: "The Planner scopes the work, the Generator produces output, and the Evaluator critiques it against the spec. Failures kick back to the Generator. Eight skills use this pattern: oc-agent-forge, oc-api-dev, oc-app-architect, oc-code-auditor, oc-integrations-engineer, oc-rag-forge, oc-signal-forge, oc-ux-engineer.",
    related: [{ label: "Architecture", href: "/architecture" }, { label: "Skill Library", href: "/skills" }],
  },
  {
    id: "audit-gate",
    term: "Audit gate",
    short: "A check that has to pass before work moves on: oc-bug-check before a commit, oc-code-auditor and oc-security-auditor before oc-deploy-ops ships.",
    long: "oc-deploy-ops runs the pre-deploy audits before it ships. That holds when the skill runs; the deploy command itself is held by a deploy wrapper or CI. oc-bug-check is the one audit gate with a mechanism of its own: the enrolled pre-commit hook. A bypass of it is recorded (see bypass record).",
    related: [{ label: "oc-code-auditor", href: "/skills/oc-code-auditor" }, { label: "oc-security-auditor", href: "/skills/oc-security-auditor" }, { label: "oc-bug-check", href: "/skills/oc-bug-check" }],
  },
  {
    id: "phase",
    term: "Phase",
    short: "One of the eight stages a project moves through — discover, spec, design, build, audit, ship, monitor, migrate.",
    long: "Each skill declares which phases it owns in its frontmatter. The Skill Library and architecture diagram are both organised by phase. A project usually traverses them linearly; migrations re-enter the build phase from the migrate phase.",
    related: [{ label: "Architecture", href: "/architecture" }],
  },
  {
    id: "slash-command",
    term: "Slash command",
    short: "Short verb users type in Claude (like /oc-discover, /oc-audit, /oc-deploy) that invokes a specific skill.",
    long: "Each skill declares its commands in frontmatter. The flags registry can disable a verb globally with skills.command.<verb>.enabled. Subcommands inherit the parent verb's gate.",
    related: [{ label: "Skill Library", href: "/skills" }],
  },
  {
    id: "pm-mcp",
    term: "PM-MCP loop",
    short: "Project-management tool integration through Claude's MCP protocol — Linear, Jira, GitHub Issues. The ticket becomes the thread of execution.",
    long: "Four skills are PM-aware (oc-app-architect, oc-git-ops, oc-deploy-ops, oc-monitoring-ops). They read the ticket on entry, transition its state on phase change, and post structured comments at boundaries. Config lives in .opchain/pm.yaml.",
    related: [{ label: "v1.3 release notes", href: "/changelog" }, { label: "oc-integrations-engineer", href: "/skills/oc-integrations-engineer" }],
  },
  {
    id: "evaluator",
    term: "Evaluator",
    short: "The third leg of a tri-agent loop — critiques the Generator's output, lists what's wrong, and decides whether to send work back.",
    long: "The Evaluator is opinionated by design: it cites the spec, names the failure modes, and grades the output. The Generator's next pass addresses each finding line-by-line.",
    related: [{ label: "tri-agent", href: "/glossary#tri-agent" }],
  },
  {
    id: "feature-flag",
    term: "Feature flag",
    short: "Named toggle in the registry that gates a skill, command, surface, or experiment without a redeploy.",
    long: "Source of truth is src/lib/flags/registry.js. Hierarchy is dot-namespaced: site.feature.*, site.ops.*.kill, skills.registry.<id>.enabled, skills.command.<verb>.enabled. PostHog supplies runtime overrides; the registry default is the fail-closed value.",
  },
  {
    id: "checkpoint-rollup",
    term: "Checkpoint rollup",
    short: "Cross-skill snapshot the orchestrator builds by reading every .checkpoints/*.checkpoint.json on the machine.",
    long: "Generated on demand by /oc-ops or npm run checkpoint:status. Useful when you're returning to a project after a week and want a one-page answer to \"what was I doing?\"",
  },
  {
    id: "scenario",
    term: "Scenario",
    short: "Curated end-to-end opchain session you can replay in the /demo workbench.",
    long: "Each scenario is a real transcript — orchestrator routing, skill invocations, generated artifacts. Used to show how the pipeline behaves under specific conditions (regulated environments, runtime PM, multi-platform deploys).",
    related: [{ label: "Demo", href: "/demo" }],
  },
  {
    id: "next-actions",
    term: "Next actions",
    short: "List of recommended commands the orchestrator surfaces at the end of every skill invocation.",
    long: "Read from the most recent checkpoint's next_actions array. The orchestrator merges across all open checkpoints so you see one ordered queue, not 18 separate ones.",
  },
  {
    id: "enrollment",
    term: "Enrollment",
    short: "Running /oc-enroll in a repository so its commits and pushes are actually checked. Installing the plugin does not do this.",
    long: "Enrollment copies the verifier runtime under the repository's Git directory, installs managed pre-commit, post-commit and pre-push hooks, and creates .opchain/. Until it succeeds, no hook in that repository checks anything. /oc-enroll --doctor reports whether the gate will run; --ci adds the pull-request workflow; --claude-md writes the repository's verbs into CLAUDE.md. New in 2.1: the post-commit and pre-push hooks and all three flags; 2.0.4 installs the pre-commit hook only.",
    related: [{ label: "Install: turn on the gate", href: "/install#enroll" }, { label: "oc-bug-check", href: "/skills/oc-bug-check" }],
  },
  {
    id: "receipt",
    term: "Receipt",
    short: "The JSON record the commit gate writes after it checks a staged tree: which tree, which policy, which checks, and the verdict.",
    long: "Receipts are bound to the exact candidate tree, so a commit with a PASS receipt is one whose bytes were checked. An identical tree reuses its PASS receipt; a rebase produces a new tree and needs a new one. Non-PASS receipts carry a log file beside them with each failing check's output. Receipts live under .git/opchain/verification-receipts/ and are local; CI re-verifies the received head.",
    related: [{ label: "INCONCLUSIVE", href: "/glossary#inconclusive" }, { label: "Bypass record", href: "/glossary#bypass-record" }],
  },
  {
    id: "inconclusive",
    term: "INCONCLUSIVE verdict",
    since: "2.1",
    short: "The commit gate's answer when a check timed out or a command inside it was not found: nothing was learned about the code, so retry.",
    long: "Distinct from FAIL, which means a check ran and the code failed it. INCONCLUSIVE covers timeouts and checks that exit 127 because a command was not found. It is retried, not bypassed. Missing dependencies are reported separately as BLOCKED, with no receipt written: install them and commit again.",
    related: [{ label: "Receipt", href: "/glossary#receipt" }],
  },
  {
    id: "bypass-record",
    term: "Bypass record",
    since: "2.1",
    short: "A file the post-commit hook writes for any commit that landed without a PASS receipt, including git commit --no-verify.",
    long: "Written to .git/opchain/bypasses/v1/<sha>.json. Git runs post-commit even when --no-verify skipped pre-commit, so a bypass cannot pass unrecorded. The pre-push hook then refuses to push the commit until it carries an Opchain-Bypass: trailer saying who approved it and why. The trailer travels with the commit to the pull request, where the PR evidence check lists it before merge; the local record never leaves the machine.",
    related: [{ label: "Install: what the hooks do", href: "/install#enroll" }, { label: "Security", href: "/security#plugin" }],
  },
  {
    id: "skill-router",
    term: "Skill router",
    since: "2.1",
    router: true,
    short: "An optional plugin hook that asks a classifier which opchain skill owns a prompt and logs the answer.",
    long: `Uses TypeSafe's Jev model (jev-1.13.0) through your own TYPESAFE_API_KEY. Calls are made with your key, under your TypeSafe account and its terms. With the key set it sends the redacted prompt, a repo summary and the active checkpoint's next action to api.typesafe.ai; the conversation tail is added only with OPCHAIN_ROUTE_CONTEXT=1, which is off by default. It runs in shadow mode. Live mode, which would add one tool-named line naming the skill, is ${ROUTER_LIVE_MODE}. Its only evaluation so far is offline. Off without a key; OPCHAIN_ROUTE=0 turns it off with one.`,
    related: [{ label: "Install: skill router", href: "/install#router" }, { label: "Shadow mode", href: "/glossary#shadow-mode" }],
  },
  {
    id: "shadow-mode",
    term: "Shadow mode",
    since: "2.1",
    router: true,
    short: "The skill router's default, and its only supported mode: it classifies and logs every prompt but adds nothing to the conversation.",
    long: `Shadow runs still call the classifier API. They exist to measure the router on real prompts before it is allowed to suggest: each log entry records the decision and, on the next prompt, what the session actually did. OPCHAIN_ROUTE_MODE=live, which adds the suggestion, is unsupported until the go/no-go records a GO.`,
    related: [{ label: "Skill router", href: "/glossary#skill-router" }],
  },
];
---

<Base
  title="Glossary · opchain"
  description="Definitions for every opchain concept — skill, checkpoint, tri-agent, orchestrator, audit gate, enrollment, receipt, and the rest."
  active="/skills"
>
  <main class="page">
    <div class="page-head">
      <Eyebrow>glossary</Eyebrow>
      <h1>Definitions.</h1>
    </div>

    <p class="lede">
      Quick reference for every opchain concept. New to skills? Start
      with <a href="#skill">skill</a> and <a href="#checkpoint">checkpoint</a>,
      then trace links from there.
    </p>

    <nav class="tocnav" aria-label="Jump to term">
      <ul>
        {terms.map((t) => (
          <li><a href={`#${t.id}`}>{t.term}</a></li>
        ))}
      </ul>
    </nav>

    <dl class="glossary">
      {terms.map((t) => (
        <div class="entry" id={t.id} data-router-copy={t.router ? "" : undefined}>
          <dt>{t.term}{t.since && <span class="since">New in {t.since}</span>}{t.router && <RouterLabel />}</dt>
          <dd>
            <p class="short"><strong>{t.short}</strong></p>
            {t.long && <p class="long">{t.long}</p>}
            {t.related && t.related.length > 0 && (
              <p class="related">
                <span class="related-label">See also:</span>
                {t.related.map((r, i) => (
                  <>
                    {i > 0 && <span class="related-sep"> · </span>}
                    <a href={r.href}>{r.label}</a>
                  </>
                ))}
              </p>
            )}
          </dd>
        </div>
      ))}
    </dl>

    <p class="footnote">
      Missing a term? <a href={REPO_NEW_ISSUE} rel="noopener">Open an issue</a>
      or send <button type="button" data-feedback-launcher class="inline-link">feedback</button>.
    </p>
  </main>
</Base>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }
  .page-head { margin-bottom: 1.25rem; }
  .page-head h1 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--ls-tight);
    margin: 0.5rem 0 0;
  }
  .lede { color: var(--muted); margin: 0 0 1.5rem; max-width: 42rem; }
  .lede a { color: var(--accent); }

  .tocnav {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--r-md);
    padding: 0.9rem 1rem;
    margin: 0 0 2rem;
  }
  .tocnav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
  }
  .tocnav a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    color: var(--muted);
    text-decoration: none;
  }
  .tocnav a:hover { color: var(--accent); }

  .glossary { margin: 0; padding: 0; }
  .entry {
    margin: 0 0 1.75rem;
    padding: 1rem 0 0;
    border-top: 0.5px solid var(--border);
    scroll-margin-top: 80px;
  }
  .entry:first-of-type { border-top: 0; padding-top: 0; }

  dt {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--ls-tight);
    margin-bottom: 0.45rem;
  }
  dt :global(.router-label) { margin-left: 0.6rem; }
  dt .since { margin-left: 0.6rem; vertical-align: middle; font-family: var(--font-mono); font-size: var(--fs-sm); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--secondary); border: 0.5px solid var(--secondary); background: var(--secondary-dim); border-radius: var(--r-pill); padding: 1px 7px; }
  dd { margin: 0; color: var(--muted); }
  dd p { margin: 0 0 0.55rem; line-height: var(--lh-base); }
  dd .short { color: var(--text); font-size: var(--fs-base); }
  dd .short strong { color: var(--text); font-weight: 500; }
  dd .long { font-size: var(--fs-sm); }
  dd .related {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--subtle);
    letter-spacing: var(--ls-wide);
    margin-top: 0.65rem;
  }
  .related-label { color: var(--subtle); margin-right: 0.4rem; }
  .related-sep { color: var(--dim); }
  .related a { color: var(--accent); text-decoration: none; }
  .related a:hover { text-decoration: underline; }
  :global([data-theme="light"]) .related a { color: var(--accent-hover); }

  .footnote {
    margin-top: 3rem;
    color: var(--subtle);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--ls-wide);
  }
  .footnote a, .inline-link {
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }
  .footnote a:hover, .inline-link:hover { text-decoration: underline; }
</style>
</Base>
