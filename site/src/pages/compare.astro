---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Card from "../components/ui/Card.astro";
import {
  PLATFORMS, FEATURES, FEATURE_GROUPS, SOURCES, REVIEWED_ON,
  FIXED_ORDER, SELECTABLE, MAX_EXTRAS, DEFAULT_EXTRAS,
} from "../data/comparison";
const FEATURE_BY_ID = Object.fromEntries(FEATURES.map((feature) => [feature.id, feature]));
const initialSelection = [...FIXED_ORDER, ...DEFAULT_EXTRAS];
const categories = [
  { id: "workflow", label: "Workflow frameworks" },
  { id: "agent", label: "Coding agents" },
];
---

<Base
  title="Compare · opchain"
  description="Compare opchain with Superpowers, Compound Engineering, BMAD, GSD Core, Spec Kit, OpenSpec, Claude Code, Codex, Cursor, Copilot, Devin and Antigravity. Source-linked features and pricing."
  active="/compare"
>
  <main class="page">
    <div class="page-head">
      <Eyebrow>compare</Eyebrow>
      <h1>Choose the workflow. Choose the agent.</h1>
    </div>
    <p class="lede">
      Compare opchain with {SELECTABLE.length} relevant alternatives: workflow frameworks that
      organize the work, and coding agents that execute it. You can use them together.
      Pick up to {MAX_EXTRAS} alongside opchain; every table entry links to its sources.
    </p>
    <p class="review-date">Sources checked <time datetime={REVIEWED_ON}>September 13, 2026</time> · <a href="#methodology">How we compare</a></p>

    <section class="quick" aria-label="Comparison guide">
      <Card variant="surface" glow={false}>
        <div class="quick-head">Start with the decision you're making</div>
        <ul class="when-list">
          <li><strong>A repeatable process for your agent</strong> → compare workflow frameworks.</li>
          <li><strong>A place to run tasks, edit code and review changes</strong> → compare coding agents.</li>
          <li><strong>Work that continues into deployment and operations</strong> → inspect the workflow and gate rows closely.</li>
        </ul>
      </Card>
    </section>

    <section class="picker-bar" aria-label="Comparison platform picker">
      <div class="picker-label">opchain stays pinned. Choose your comparison:</div>
      <div class="preset-tray">
        <button type="button" class="preset" data-preset="workflows">Closest workflows</button>
        <button type="button" class="preset" data-preset="agents">Coding agents</button>
        <button type="button" class="chip-reset" id="chip-reset">Clear selection</button>
        <span class="chip-counter" id="chip-counter" role="status" aria-live="polite">{DEFAULT_EXTRAS.length} of {MAX_EXTRAS} selected</span>
      </div>
      {categories.map((category) => (
        <div class="picker-group" role="group" aria-label={category.label}>
          <p class="picker-category">{category.label}</p>
          <div class="chip-tray">
            {SELECTABLE.filter((id) => PLATFORMS[id].category === category.id).map((id) => (
              <button type="button" class="chip" data-chip={id}
                data-selected={DEFAULT_EXTRAS.includes(id) ? "true" : "false"}
                aria-pressed={DEFAULT_EXTRAS.includes(id) ? "true" : "false"}>
                <span class="chip-name">{PLATFORMS[id].name}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
      <noscript><p>Enable JavaScript to change columns. The default comparison and all source links work without it.</p></noscript>
    </section>

    <p class="scroll-hint" id="table-help">Scroll sideways to compare columns. Remove a selection to make room for another.</p>
    <section class="table-wrap" id="comparison-region" tabindex="0" aria-label="Feature comparison, scroll horizontally" aria-describedby="table-help"
      style={`--compare-columns: ${initialSelection.length}`}>
      <table class="cmp" id="cmp-table">
        <caption class="sr-only">Documented capabilities of opchain and selected alternatives</caption>
        <thead><tr id="cmp-head">
          <th scope="col">Compare by</th>
          {initialSelection.map((id) => <th scope="col" class:list={[{ me: PLATFORMS[id].accent }]} data-col={id}>{PLATFORMS[id].name}</th>)}
        </tr></thead>
        <tbody id="cmp-body">
          {FEATURE_GROUPS.flatMap((group) => [
            <tr class="group-head" data-group={group.id}><th colspan={initialSelection.length + 1}><span>{group.label}</span></th></tr>,
            ...group.featureIds.map((fid) => (
              <tr data-feature={fid}>
                <th scope="row">{FEATURE_BY_ID[fid].label}</th>
                {initialSelection.map((id) => {
                  const p = PLATFORMS[id];
                  const cell = p.cells[fid];
                  return <td class:list={[{ me: p.accent }]} data-col={id}>
                    <span class="cell-v">{cell.v}</span>
                    {cell.note && <span class="cell-note">{cell.note}</span>}
                    <span class="cell-sources">
                      {cell.sources.map((sid) => <a href={SOURCES[sid].url} class="source-link" data-source={sid}
                        aria-label={`${p.name}, ${FEATURE_BY_ID[fid].label} — source ${SOURCES[sid].number}: ${SOURCES[sid].title}`}
                        title={SOURCES[sid].title}>[{SOURCES[sid].number}]</a>)}
                    </span>
                  </td>;
                })}
              </tr>
            )),
          ])}
        </tbody>
      </table>
    </section>

    <section class="block" id="methodology">
      <h2>How we compare</h2>
      <p>
        This is a review of official documentation and maintainer repositories, checked on
        September 13, 2026. It is not a hands-on benchmark or a popularity ranking.
        The selection emphasizes reusable workflows, retained context, verification and practical coding execution.
        VS Code and Zed are omitted as standalone hosts to keep this comparison focused.
      </p>
      <p>
        Entries describe the documented core offering. Scope assessments such as “project-specific” or
        “not described” are our interpretation of the cited sources, not proof that a product cannot do something.
        Optional modules, beta features and host dependencies are called out where relevant.
        Review prompts, permission controls and CI-enforced gates do different jobs.
      </p>
      <p>
        Prices are public USD monthly list prices where stated, before tax; annual discounts and temporary
        promotions are excluded. Free workflow software still uses a paid or quota-limited agent/model.
        Check the linked pricing page for current quotas, overages and regional availability.
      </p>
      <p>
        opchain is free, <a href="/LICENSE">Apache-2.0 licensed</a>, and compared against its
        2.0 skills and packaged runtime. <a href="/skills/oc-hindsight">Hindsight</a> retains reviewed lessons;
        <a href="/skills/oc-evolve">Evolve</a> requires before-and-after task evidence and signed external
        approval before adopting a rule. Learning is off by default. Retrieving approved context is explicit;
        automatic host injection needs separate setup. These controls do not establish a measured advantage
        over another product. Persistent files, reusable skills and multiple agents are also offered by
        several alternatives; we assign no overall winner.
      </p>
    </section>

    <section class="block">
      <h2>Use opchain with your existing tools</h2>
      <div class="switch-grid">
        <Card variant="surface" glow={false}>
          <div class="quick-head">Keep your coding agent</div>
          <p>Use the <a href="/install">installation guide</a> for your host.
            Check which tools and hooks that surface supports; downloading skills alone does not install enforcement.</p>
        </Card>
        <Card variant="surface" glow={false}>
          <div class="quick-head">Start with one workflow</div>
          <p>Browse the <a href="/skills">skill library</a> or use the
            <a href="/pipeline-builder">pipeline builder</a> to choose a bundle.
            For an existing codebase, <a href="/skills/oc-reverse-spec">oc-reverse-spec</a> can establish the project context.</p>
        </Card>
      </div>
    </section>

    <section class="block" aria-label="Comparison sources">
      <details class="sources-index">
        <summary>Sources · {Object.keys(SOURCES).length} official documentation and repository links</summary>
        <ol>{Object.entries(SOURCES).map(([id, source]) => <li id={`source-${id}`}><a href={source.url}>{source.title}</a></li>)}</ol>
      </details>
      <p class="footnote">Spot an outdated detail? <button type="button" class="inline-link" data-feedback-launcher>Tell us</button>.</p>
    </section>
  </main>
</Base>

<script>
  import { PLATFORMS, FEATURES, FEATURE_GROUPS, SOURCES, FIXED_ORDER, SELECTABLE, MAX_EXTRAS, DEFAULT_EXTRAS, PRESETS } from "../data/comparison";
  const FEATURE_BY_ID = Object.fromEntries(FEATURES.map((f) => [f.id, f]));
  const STORAGE_KEY = "opchain-compare-selection";
  // Client-created nodes must retain Astro's scoped style attribute.
  const sample = document.querySelector(".cmp td");
  const cid = sample?.getAttributeNames().find((name) => name.startsWith("data-astro-cid-"));
  function element<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) {
    const el = document.createElement(tag);
    if (cid) el.setAttribute(cid, "");
    if (text !== undefined) el.textContent = text;
    if (className) el.className = className;
    return el;
  }
  function loadExtras(): string[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw === null) return [...DEFAULT_EXTRAS];
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [...DEFAULT_EXTRAS];
      const valid = [...new Set(parsed.filter((id): id is string => typeof id === "string" && SELECTABLE.includes(id)))];
      // An intentionally empty selection stays empty. Retired-only selections recover to defaults.
      return parsed.length && !valid.length ? [...DEFAULT_EXTRAS] : valid.slice(0, MAX_EXTRAS);
    } catch { return [...DEFAULT_EXTRAS]; }
  }
  let extras = loadExtras();
  function renderChips() {
    document.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((chip) => {
      const id = chip.dataset.chip!;
      const selected = extras.includes(id);
      chip.dataset.selected = String(selected);
      chip.setAttribute("aria-pressed", String(selected));
      chip.disabled = !selected && extras.length >= MAX_EXTRAS;
      chip.title = chip.disabled ? `Remove a selection before adding ${PLATFORMS[id].name}` : `Toggle ${PLATFORMS[id].name}`;
    });
    document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => {
      const preset = PRESETS[button.dataset.preset as keyof typeof PRESETS];
      button.setAttribute("aria-pressed", String(extras.length === preset.length && preset.every((id, i) => extras[i] === id)));
    });
    const counter = document.getElementById("chip-counter");
    if (counter) counter.textContent = `${extras.length} of ${MAX_EXTRAS} selected`;
  }
  function renderTable() {
    const cols = [...FIXED_ORDER, ...extras];
    const region = document.getElementById("comparison-region");
    region?.style.setProperty("--compare-columns", String(cols.length));
    const head = document.getElementById("cmp-head")!;
    const corner = element("th", "Compare by"); corner.scope = "col";
    head.replaceChildren(corner);
    cols.forEach((id) => {
      const th = element("th", PLATFORMS[id].name, PLATFORMS[id].accent ? "me" : undefined);
      th.scope = "col"; th.dataset.col = id; head.append(th);
    });
    const body = document.getElementById("cmp-body")!;
    const rows = document.createDocumentFragment();
    FEATURE_GROUPS.forEach((group) => {
      const groupRow = element("tr", undefined, "group-head"); groupRow.dataset.group = group.id;
      const heading = element("th"); heading.colSpan = cols.length + 1;
      heading.append(element("span", group.label));
      groupRow.append(heading); rows.append(groupRow);
      group.featureIds.forEach((fid) => {
        const feature = FEATURE_BY_ID[fid];
        const row = element("tr"); row.dataset.feature = fid;
        const label = element("th", feature.label); label.scope = "row"; row.append(label);
        cols.forEach((id) => {
          const platform = PLATFORMS[id]; const cell = platform.cells[fid];
          const td = element("td", undefined, platform.accent ? "me" : undefined); td.dataset.col = id;
          td.append(element("span", cell.v, "cell-v"));
          if (cell.note) td.append(element("span", cell.note, "cell-note"));
          const sources = element("span", undefined, "cell-sources");
          cell.sources.forEach((sid) => {
            const source = SOURCES[sid];
            const link = element("a", `[${source.number}]`, "source-link");
            link.href = source.url; link.dataset.source = sid; link.title = source.title;
            link.setAttribute("aria-label", `${platform.name}, ${feature.label} — source ${source.number}: ${source.title}`);
            sources.append(link);
          });
          td.append(sources); row.append(td);
        });
        rows.append(row);
      });
    });
    body.replaceChildren(rows);
  }
  function update() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(extras)); } catch { /* Storage may be disabled. */ }
    renderChips(); renderTable();
  }
  document.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((chip) => chip.addEventListener("click", () => {
    const id = chip.dataset.chip!;
    if (extras.includes(id)) extras = extras.filter((other) => other !== id);
    else if (extras.length < MAX_EXTRAS) extras.push(id);
    update();
  }));
  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) => button.addEventListener("click", () => {
    extras = [...PRESETS[button.dataset.preset as keyof typeof PRESETS]]; update();
  }));
  document.getElementById("chip-reset")?.addEventListener("click", () => { extras = []; update(); });
  renderChips();
  if (extras.length !== DEFAULT_EXTRAS.length || extras.some((id, i) => id !== DEFAULT_EXTRAS[i])) renderTable();
</script>

<style>

  .page { max-width: 1040px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
  .page-head { margin-bottom: 1.25rem; }
  .page-head h1 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--ls-tight);
    margin: 0.5rem 0 0;
  }
  .lede { color: var(--muted); margin: 0 0 2rem; max-width: 42rem; line-height: var(--lh-base); }

  .quick { margin-bottom: 1.5rem; max-width: 760px; }
  .quick-head {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--subtle);
    margin-bottom: 0.5rem;
  }
  .when-list { margin: 0; padding-left: 1.1rem; color: var(--muted); }
  .when-list li { margin-bottom: 0.35rem; line-height: var(--lh-base); }
  .when-list strong { color: var(--text); font-weight: 500; }
  .when-list code, .block code, .cta code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    padding: 1px 5px;
    border-radius: var(--r-xs);
    color: var(--text);
  }

  /* ── Picker bar (chip tray) ────────────────────────────────────── */
  .picker-bar {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--r-md);
    padding: 0.9rem 1.1rem;
    margin: 0 0 1rem;
  }
  .picker-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--subtle);
    margin: 0 0 0.55rem;
  }
  .chip-tray {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .chip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 0.5px solid var(--border);
    background: var(--card);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }
  .chip:hover { color: var(--text); border-color: var(--accent); }
  .chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .chip[data-selected="true"] {
    background: var(--accent-dim);
    border-color: var(--accent);
    color: var(--text);
  }
  /* B-10 light-mode contrast — match what /skills uses for accent on surface */
  :global([data-theme="light"]) .chip[data-selected="true"] { color: var(--text); }
  .chip[data-selected="true"] .chip-name::before { content: "✓ "; font-weight: 700; }
  .chip:disabled { opacity: 0.45; cursor: not-allowed; }
  .chip:disabled:hover { color: var(--muted); border-color: var(--border); }

  .chip-counter {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--subtle);
    letter-spacing: var(--ls-wide);
  }
  .chip-reset {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    cursor: pointer;
    text-decoration: underline;
    padding: 0.45rem 0.4rem;
  }
  .chip-reset:hover { color: var(--text); }
  .chip-reset[hidden] { display: none; }



  /* ── Table ─────────────────────────────────────────────────────── */
  /* Grouped comparison with a sticky row-label column. */
  .table-wrap {
    overflow-x: auto;
    margin: 0 0 2.5rem;
    border: 0.5px solid var(--border);
    border-radius: var(--r-md);
    /* Hint that horizontal scroll is available without painting a
       scrollbar shadow over the table edges. */
    background: var(--bg);
  }
  .cmp {
    width: 100%;

    min-width: calc(10rem + var(--compare-columns) * 13rem);
    table-layout: fixed;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .cmp th, .cmp td {
    padding: 0.7rem 0.85rem;
    border-bottom: 0.5px solid var(--border);
    text-align: left;
    vertical-align: top;
    transition: background-color var(--dur-fast, 120ms) var(--ease-standard, ease),
                box-shadow    var(--dur-fast, 120ms) var(--ease-standard, ease),
                color         var(--dur-fast, 120ms) var(--ease-standard, ease);
  }
  .cmp thead th {
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--subtle);
    border-bottom: 0.5px solid var(--border);
    font-weight: 500;
  }
  /* opchain column header: release accent gradient + bottom strip */
  .cmp thead th.me {
    color: var(--text);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--accent) 22%, var(--surface)),
      var(--surface));
    font-weight: 600;
    position: relative;
  }
  .cmp thead th.me::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--accent);
  }
  :global([data-theme="light"]) .cmp thead th.me { color: var(--text); }

  /* Row-label column — sticky-left so it stays visible during
     horizontal scroll (most impactful on mobile/tablet). Opaque
     background so cells underneath don't bleed through. */
  .cmp tbody th[scope="row"] {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    font-size: var(--fs-sm);
    width: 10rem;
    background: var(--surface);
    border-right: 0.5px solid var(--border);
    position: sticky;
    left: 0;
    z-index: 1;
  }
  .cmp td { color: var(--muted); }

  /* Group-head row — sticky-left like the row labels; spans the table
     so users always see which category they're in. */
  .cmp tbody tr.group-head th {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 8%, var(--raised, var(--surface)));
    padding-top: 0.85rem;
    padding-bottom: 0.6rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .cmp tbody tr.group-head th span { display: inline-block; position: sticky; left: var(--space-3); max-width: 17rem; }
  :global([data-theme="light"]) .cmp tbody tr.group-head th { color: var(--text); }
  /* The first group-head row doesn't need a top border — the thead
     accent strip already terminates the header. */
  .cmp tbody tr.group-head:first-child th { border-top: 0; }

  /* Zebra striping — only on FEATURE rows (skip group-head). */
  .cmp tbody tr:not(.group-head):nth-of-type(even) td,
  .cmp tbody tr:not(.group-head):nth-of-type(even) th[scope="row"] {
    background: color-mix(in srgb, var(--surface) 55%, var(--bg));
  }
  :global([data-theme="light"]) .cmp tbody tr:not(.group-head):nth-of-type(even) td,
  :global([data-theme="light"]) .cmp tbody tr:not(.group-head):nth-of-type(even) th[scope="row"] {
    background: color-mix(in srgb, var(--surface) 60%, var(--bg));
  }

  /* opchain column body cells — accent fill that beats zebra. */
  .cmp td.me {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-left:  1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-right: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .cmp tbody tr:not(.group-head):nth-of-type(even) td.me {
    background: color-mix(in srgb, var(--accent) 13%, transparent);
  }

  .cell-v {
    display: block;
    color: var(--text);
    margin-bottom: 0.2rem;
  }
  .cell-note {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: var(--ls-wide);
    line-height: 1.35;
  }
  .cmp td.me .cell-v { color: var(--text); font-weight: 600; }
  /* Tinted cells need stronger text in both release themes. */
  .cmp td.me .cell-note, .cmp td.me .source-link { color: var(--text); }
  :global([data-theme="light"]) .cmp td.me .cell-v { color: var(--text); }

  /* Row hover — outline the whole row with a thin accent frame so the
     reader can lock onto a feature and walk across columns. Skip
     group-head rows (they're already framed). */
  .cmp tbody tr:not(.group-head):hover td,
  .cmp tbody tr:not(.group-head):hover th[scope="row"] {
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--accent) 55%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .cmp tbody tr:not(.group-head):hover th[scope="row"] { color: var(--text); }
  .cmp tbody tr:not(.group-head):hover td.me {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .cmp th, .cmp td { transition: none; }
  }

  /* Tighter row-label column on mobile so the sticky cell doesn't
     eat half the viewport. */
  @media (max-width: 640px) {
    .cmp tbody th[scope="row"] { width: 140px; font-size: 12.5px; }
    .cmp th, .cmp td { padding: 0.55rem 0.6rem; }
  }

  /* ── Below-table sections (carried over from prior /compare) ───── */
  .block { margin: 0 0 2.5rem; max-width: 720px; }
  .block h2 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.8rem;
  }
  .block p {
    color: var(--muted);
    margin: 0 0 0.75rem;
    line-height: var(--lh-base);
  }
  .block a { color: var(--text); text-decoration: underline; text-underline-offset: var(--space-1); }

