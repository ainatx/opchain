# opchain.dev — environment variable template.
# Copy this file to .dev.vars for local `wrangler dev` use AND for deploys
# (scripts/deploy.mjs loads .dev.vars at preflight time).
# Runtime secrets for the Worker also need to be set via the Cloudflare
# dashboard or `wrangler secret put`.

# ── Linear (feedback widget) ────────────────────────────────────────────────
# Linear API key — used by POST /api/feedback to create issues (Worker
# runtime) for bug/improvement/security/general tickets. NOT required to
# deploy — the /changelog roadmap itself is sourced from GitHub Issues, not
# Linear (see the Roadmap section below). Leave it unset locally and
# POST /api/feedback returns 503 "not_configured" rather than blocking deploy.
# Get one at https://linear.app/settings/api
LINEAR_API_KEY=
# Override default team/project if deploying against a different Linear workspace.
# LINEAR_TEAM_ID=
# LINEAR_PROJECT_ID=
# Set FEEDBACK_DRY_RUN="true" to accept submissions without writing to Linear
# or GitHub (returns a synthetic 201 with id "STAGING-DRY-RUN"). Already wired
# into wrangler.jsonc env.staging — production leaves it unset.
# FEEDBACK_DRY_RUN=

# ── Roadmap (GitHub Issues) ─────────────────────────────────────────────────
# scripts/gen-roadmap.mjs reads roadmap:* labelled issues from the public
# asfbay-bit/opchain-skills repo (read path — powers /changelog). No token
# required — anonymous public reads are enough (60 req/hr, four label-scoped
# calls per run). Set GITHUB_TOKEN only if you're hitting that rate limit
# locally; never required to deploy.
# GITHUB_TOKEN=
#
# ROADMAP_GITHUB_TOKEN (write path, Worker runtime) — a separate, fine-grained
# PAT scoped to issues:write on asfbay-bit/opchain-skills. Used by
# POST /api/feedback's roadmap community-request path (RoadmapForm.astro) to
# create a GitHub issue instead of a Linear ticket. Unset → that one path
# 503s "not_configured"; nothing else on /api/feedback is affected.
# ROADMAP_GITHUB_TOKEN=

# ── Notify (install/download soft-gate capture) ─────────────────────────────
# Storage is a KV namespace, not an env var. Provision once with:
#   wrangler kv:namespace create NOTIFY
#   wrangler kv:namespace create NOTIFY --preview
# then drop the IDs into wrangler.jsonc › kv_namespaces. The handler
# accepts submissions even when the binding is missing (just doesn't
# persist them) so local dev works without provisioning.

# ── Analytics (PostHog server-side capture) ────────────────────────────────
# If POSTHOG_PROJECT_API_KEY is unset, analytics is a no-op.
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# Client-side PostHog (consent-gated). Exposed via site/src/components/ConsentBanner.astro.
#
# Both values are required; no host default is baked into self-hosted builds.
# Official operators set OPCHAIN_OFFICIAL_ANALYTICS=1 while deploying to select
# the managed staging/production proxy and public project key. Self-hosters
# should supply their own key and a `*.i.posthog.com` host, or leave both
# unset. A custom proxy/domain also requires adding that origin to the
# script-src and connect-src policies in src/lib/http.js.
#
# Override here for local dev only — Astro reads .env at build time. To run
# `npm run site:dev` against a real PostHog project, set both:
# PUBLIC_POSTHOG_KEY=phc_m4mpaJBA3EsEFRiGeVQWESFX8pz6CtS6B8y85Va6rmJV
# PUBLIC_POSTHOG_HOST=https://t.opchain.dev

# ── Hosted MCP checkpoint sessions ─────────────────────────────────────────
# Required by POST /mcp create_checkpoint_session. Use an independent random
# value of at least 32 bytes and store a DIFFERENT Worker secret in each environment:
#   openssl rand -base64 48 | npx wrangler secret put MCP_SESSION_SIGNING_KEY
#   openssl rand -base64 48 | npx wrangler secret put MCP_SESSION_SIGNING_KEY --env staging
# Rotating it invalidates existing hosted checkpoint session tokens. Do not
# reuse an API token or commit the generated value.
# MCP_SESSION_SIGNING_KEY=

# ── Feature flags ──────────────────────────────────────────────────────────
# Runtime flag values come from PostHog's /decide API (uses the same
# POSTHOG_PROJECT_API_KEY/POSTHOG_HOST as analytics). When PostHog is
# unconfigured, every flag falls back to the default declared in
# src/lib/flags/registry.js — the source of truth.
#
# Wrangler env-var overrides win over PostHog and the default. The naming
# convention is FLAG_<UPPER_SNAKE>: e.g. site.ops.api-feedback.kill →
# FLAG_SITE_OPS_API_FEEDBACK_KILL. Booleans accept "true"/"false"/"1"/"0".
# Useful for staging-only kill switches and forcing a value in tests.
# FLAG_SITE_OPS_API_FEEDBACK_KILL=true
# FLAG_SITE_OPS_API_NOTIFY_KILL=true
# FLAG_SITE_OPS_API_HEALTH_DETAILED=true
